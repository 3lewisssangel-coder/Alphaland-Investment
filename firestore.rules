rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Users collection: mobileNumber, password, balance, referralCode, referredBy, createdAt
    match /users/{userId} {
      allow read, write: if true;
    }

    // Investments collection: userId, planName, cost, dailyReturn, daysRemaining, createdAt
    match /investments/{investmentId} {
      allow read, write: if true;
    }

    // Deposits collection: userId, amount, proofImageUrl, status, createdAt
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Withdrawals collection: userId, amount, status, createdAt
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // Settings collection: activeDepositQrUrl, etc.
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
